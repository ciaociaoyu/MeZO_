#!/usr/bin/env fish
set -gx LMOD_ROOT /apps/lmod
set -gx LMOD_PKG  /apps/lmod/lmod
set -gx LMOD_DIR  /apps/lmod/lmod/libexec
set -gx LMOD_CMD  /apps/lmod/lmod/libexec/lmod

set -gx MODULESHOME /apps/lmod/lmod

set -gx LMOD_VERSION "8.7.59"

set -gx FPATH (/apps/lmod/lmod/libexec/addto --append FPATH /apps/lmod/lmod/init/ksh_funcs)

if status -i
   function module
      eval $LMOD_CMD fish $argv | source -
   end
else
   function module
      eval $LMOD_CMD fish --no_redirect $argv | source -
   end
end

function ml
   eval $LMOD_DIR/ml_cmd $argv | source -
end
